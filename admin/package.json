{
  "name": "@blending/admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "tsx --test src/**/*.test.ts src/**/**/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write --no-error-on-unmatched-pattern app src e2e playwright.config.ts package.json vercel.json README.md",
    "format:check": "prettier --check --no-error-on-unmatched-pattern app src e2e playwright.config.ts package.json vercel.json README.md",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blending/admin-contracts": "workspace:*",
    "axios": "1.16.0",
    "lucide-react": "1.14.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  }
}
