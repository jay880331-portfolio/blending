{
  "name": "@blending/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "backfill:search": "tsx scripts/backfill-search-documents.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "admin:indexes": "tsx scripts/ensure-admin-indexes.ts",
    "admin:smoke-fixture": "tsx scripts/manage-admin-smoke-fixture.ts",
    "migrate:guide-content": "tsx scripts/migrate-guide-content.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write app/api src scripts ../docs/social-login-setup.md package.json",
    "format:check": "prettier --check app/api src scripts ../docs/social-login-setup.md package.json",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "check:architecture": "tsx scripts/check-architecture.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@blending/admin-contracts": "workspace:*",
    "@blending/bridge": "workspace:*",
    "@next/env": "16.2.6",
    "@webview-bridge/web": "1.7.9",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "axios": "1.16.0",
    "jose": "^6.2.5",
    "lucide-react": "1.14.0",
    "mongodb": "^7.2.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5",
    "solapi": "^6.0.1",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "latest",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  }
}
