{
  "name": "blending",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:admin": "pnpm --filter @blending/admin dev",
    "build:admin": "pnpm --filter @blending/admin build",
    "start:admin": "pnpm --filter @blending/admin start",
    "dev:web": "pnpm --filter @blending/web dev",
    "build:web": "pnpm --filter @blending/web build",
    "start:web": "pnpm --filter @blending/web start",
    "dev:homepage": "pnpm --filter @blending/homepage dev",
    "build:homepage": "pnpm --filter @blending/homepage build",
    "start:homepage": "pnpm --filter @blending/homepage start",
    "backfill:search": "corepack pnpm --filter @blending/web backfill:search",
    "dev:app": "pnpm --filter @blending/app start",
    "android": "pnpm --filter @blending/app android",
    "ios": "pnpm --filter @blending/app ios",
    "build:app:local:android": "./scripts/build-app-local.sh android production",
    "build:app:local:ios": "./scripts/build-app-local.sh ios production",
    "deploy:app:local": "./scripts/deploy-app-local.sh all production",
    "deploy:app:local:android": "./scripts/deploy-app-local.sh android production",
    "deploy:app:local:ios": "./scripts/deploy-app-local.sh ios production",
    "sync:app-version-policy": "./scripts/sync-mobile-version-policy-from-eas.sh all production",
    "sync:app-version-policy:android": "./scripts/sync-mobile-version-policy-from-eas.sh android production",
    "sync:app-version-policy:ios": "./scripts/sync-mobile-version-policy-from-eas.sh ios production",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r --if-present format:check",
    "test": "pnpm -r --if-present test && pnpm --filter @blending/web exec tsx --test ../scripts/admin-ci-config.test.ts",
    "typecheck": "pnpm -r typecheck"
  }
}
